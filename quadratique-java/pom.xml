<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>inf563</groupId>
  <artifactId>quadratique-java</artifactId>
  <version>1.0.0</version>
  <name>Solveur ax² + bx + c = 0 (JUnit 5 + allpairs4j + JaCoCo)</name>

  <properties>
    <!-- Java 8 : compatible avec tous les JDK (8, 11, 17, 21) -->
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <jacoco.version>0.8.12</jacoco.version>
    <!-- Fenêtre de saisie des valeurs désactivée sous Maven (build reproductible) ;
         mvn test -Dvaleurs.demander=true pour la réactiver. -->
    <valeurs.demander>false</valeurs.demander>
  </properties>

  <dependencies>
    <!-- Framework de test : JUnit 5 (Jupiter) + tests paramétrés -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Génération des données de test : algorithme All-Pairs -->
    <dependency>
      <groupId>io.github.pavelicii</groupId>
      <artifactId>allpairs4j</artifactId>
      <version>2.0.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <systemPropertyVariables>
            <valeurs.demander>${valeurs.demander}</valeurs.demander>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!--
        JaCoCo : couverture de code de l'implémentation (src/main) par les tests.
          mvn verify  →  rapport HTML dans target/site/jacoco/index.html
        - prepare-agent : branche l'agent JaCoCo sur la JVM des tests (via argLine) ;
          il instrumente les classes au chargement, donc il mesure aussi le code
          appelé par réflexion (Class.forName + Method.invoke).
        - report        : génère le rapport HTML / XML / CSV après les tests.
        - check         : fait échouer le build si la couverture passe sous les seuils.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>CLASS</element>
                  <includes>
                    <include>quadratique.Solveur</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        PIT (Pitest) : tests de mutation.
          mvn test-compile org.pitest:pitest-maven:mutationCoverage
          →  rapport HTML dans target/pit-reports/index.html
        PIT crée des « mutants » de Solveur (copies avec UNE erreur volontaire :
        > devient >=, + devient -, une condition inversée, un return null…) et
        relance la suite JUnit sur chacun. Mutant TUÉ = au moins un test échoue
        (l'erreur est détectée) ; mutant SURVIVANT = aucun test ne la voit.
        Score de mutation = mutants tués / mutants générés.
      -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.20.2</version>
        <dependencies>
          <!-- Support JUnit 5 -->
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.3</version>
          </dependency>
        </dependencies>
        <configuration>
          <!-- Code muté : uniquement l'implémentation de l'équation -->
          <targetClasses>
            <param>quadratique.Solveur</param>
          </targetClasses>
          <!-- Suite de tests utilisée pour tuer les mutants (classes imbriquées comprises) -->
          <targetTests>
            <param>quadratique.SolveurTest*</param>
          </targetTests>
          <!-- Jeu d'opérateurs de mutation plus riche que celui par défaut -->
          <mutators>
            <mutator>STRONGER</mutator>
          </mutators>
          <!-- Graine fixe et pas de fenêtre : chaque mutant est testé avec les
               MÊMES valeurs, sinon l'analyse ne serait pas reproductible. -->
          <jvmArgs>
            <value>-Dgraine=1</value>
            <value>-Dvaleurs.demander=false</value>
            <value>-Djava.awt.headless=true</value>
          </jvmArgs>
          <!-- Le build échoue si le score de mutation passe sous 95 %
               (seul survivant attendu : 1 mutant équivalent, voir rapport) -->
          <mutationThreshold>95</mutationThreshold>
          <outputFormats>
            <format>HTML</format>
            <format>XML</format>
          </outputFormats>
          <timestampedReports>false</timestampedReports>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
